{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "channel": "production"
    },
    "apk-universal": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview",
      "env": {
        "ZEROMB_ARCHS": "armeabi-v7a,arm64-v8a,x86_64,x86"
      }
    },
    "apk-armv7": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview",
      "env": {
        "ZEROMB_ARCHS": "armeabi-v7a"
      }
    }
  }
}
